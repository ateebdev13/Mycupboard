{
  "expo": {
    "name": "The Cupboard",
    "slug": "merawardrobe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "merawardrobe",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F2E7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.merawardrobe.app"
    },
    "android": {
      "package": "com.merawardrobe.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F2E7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "The Cupboard uses your photo library to add garments to your digital wardrobe.",
          "cameraPermission": "The Cupboard uses your camera to photograph garments for your digital wardrobe."
        }
      ]
    ],
    "extra": {
      "router": {}
    }
  }
}
